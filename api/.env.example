APP_NAME=RAT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4000
# Port for `php artisan serve` / `composer dev`. Short links are served from BASE_URL, so keep them in sync.
SERVER_PORT=4000

# The Next.js app. Used for links in emails (password reset, email verification)
# and as the allowed CORS origin when the frontend talks to the API directly.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=rat

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null when Next.js proxies the API (default). When the browser calls the
# API on a sibling subdomain, set to the shared parent domain, e.g. ".example.com".
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

# Hosts (with port) whose requests are authenticated with session cookies.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Comma separated proxy IPs/CIDRs to trust for X-Forwarded-* headers, or "*".
# The Next.js server proxies API calls, so trust it to get real client IPs.
TRUSTED_PROXIES=127.0.0.1,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Short-link origin; customUrl is BASE_URL/{slug}.
BASE_URL=http://localhost:4000
SOCIAL_REFRESH_MINUTES=15

# Timezone for a click's dayOfWeek, hourOfDay and fullDateClicked (clickedAt is UTC).
# The old Express server used its process timezone.
CLICK_TIMEZONE=UTC

# Opt-in project-scoped visitor identity. Use a persistent, dedicated random secret
# of at least 32 characters. Rotation starts a new measurement epoch.
VISITOR_TRACKING_ENABLED=false
VISITOR_SECRET=
VISITOR_COOKIE_NAME=rat_vid
VISITOR_COOKIE_MAX_AGE_DAYS=90

# Optional absolute path to a MaxMind GeoLite2 City / GeoIP2 City .mmdb file.
# With no database, unavailable addresses, or lookup failure, clicks store geo=null.
GEOIP_DATABASE=

# Raw IPs stay private. Retention is explicit; there is no automatic purge at boot.
# Used by `php artisan rat:purge-raw-ips` (dry-run unless --apply) when --retention-days
# and --batch-size are not passed. The batch size defaults to 500 and is capped at 5000.
# IP_RETENTION_DAYS=90
# IP_RETENTION_BATCH_SIZE=500

# Password resets use Laravel's cache token repository and the default cache store.
# AUTH_PASSWORD_RESET_STORE=file
QUEUE_FAILED_DRIVER=file
