# Display name used in the UI.
NEXT_PUBLIC_APP_NAME=RAT

# Laravel API origin as seen from the Next.js server. `/api/*` and `/sanctum/*`
# are proxied here (see next.config.ts), so the browser only talks to Next.js.
API_URL=http://localhost:4000

# Optional: call the API directly from the browser instead of through the proxy,
# e.g. https://api.example.com. Requires the API and app to share a parent domain
# (SESSION_DOMAIN=.example.com) and FRONTEND_URL/SANCTUM_STATEFUL_DOMAINS set in Laravel.
# NEXT_PUBLIC_API_URL=
